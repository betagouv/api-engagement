# Copier ce fichier en .env et remplir les valeurs
# Le .env est ignoré par git (.gitignore racine)

# GitHub — token avec accès en lecture aux PRs du repo
# En local : gh auth token
# En CI : fourni automatiquement par GitHub Actions
GITHUB_TOKEN=

# Notion — Internal Integration Token (commence par secret_)
# https://www.notion.so/my-integrations
NOTION_API_KEY=secret_

# ID de la base de données Notion changelog (32 chars hex dans l'URL de la DB)
NOTION_CHANGELOG_DATABASE_ID=

# OpenAI — clé API
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-

# Slack — Bot Token (commence par xoxb-)
# Même token que celui déjà configuré dans api/
SLACK_TOKEN=xoxb-

# ID du channel Slack dédié aux releases
SLACK_RELEASE_CHANNEL_ID=
