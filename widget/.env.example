# Variables du widget (config.ts). Copier en .env : cp .env.example .env
#
# Origine en staging / production :
#   [tfvars]  terraform/containers.tf, lues au démarrage du conteneur (serveur Next)
#   [gh]      variable GitHub (vars.*), figée dans le bundle au build (docker-build-push.yml)

ENV=development                                   # [tfvars]
API_URL=http://localhost:4000                     # [tfvars] api_hostname

# Sentry (désactivé en development)
# SENTRY_DSN=                                     # [gh] vars.SENTRY_DSN_WIDGET, côté serveur (via Terraform)
# NEXT_PUBLIC_ENV=                                # [gh] environnement du build, côté navigateur
# NEXT_PUBLIC_SENTRY_DSN=                         # [gh] vars.SENTRY_DSN_WIDGET, côté navigateur

# Envoi des sourcemaps à Sentry au build (inutile en local)
# SENTRY_HOST=                                    # [gh] vars.SENTRY_HOST
# SENTRY_AUTH_TOKEN=                              # [gh] secret SENTRY_AUTH_TOKEN
