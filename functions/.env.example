# Variables de la fonction sentry-webhook et du script de déploiement manuel (scripts/deploy.mts).
# Copier en .env : cp .env.example .env — voir functions/README.md.
#
# Origine en staging (terraform/functions.tf) :
#   [tfvars]  terraform/envs/staging.tfvars
#   [scw]     secret Scaleway "staging-secret"

SLACK_TOKEN=                                      # [scw]
SLACK_CHANNEL_ID_PRODUCTION=                      # [tfvars] sentry_slack_channel_id_production
SLACK_CHANNEL_ID_STAGING=                         # [tfvars] sentry_slack_channel_id_staging
# SENTRY_CLIENT_SECRET=                           # [scw] vide = signature non vérifiée
# DEBUG_PAYLOAD=false                             # [tfvars] sentry_webhook_debug_payload

# Déploiement manuel uniquement
# SCW_PROJECT_ID=
# SCW_SECRET_KEY=
