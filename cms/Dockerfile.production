FROM node:22-alpine AS builder
# Dépendances natives de sharp (images) et de strapi.
RUN apk add --no-cache build-base gcc autoconf automake zlib-dev libpng-dev vips-dev git > /dev/null 2>&1
WORKDIR /opt/app
# @gouvfr/dsfr >= 1.15.0 gate le preinstall sur l'acceptation des CGU.
ENV DSFR_ACCEPT_LICENSE=1

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ENV NODE_ENV=production
# Environnement (staging/production) inliné dans le bundle de l'admin (bandeau pré-prod) : STRAPI_ADMIN_* est lu au build.
ARG ENV
ENV STRAPI_ADMIN_ENV=$ENV
# Domaine public du site (aperçu de l'URL d'une page) : même mécanisme.
ARG PLATEFORM_URL
ENV STRAPI_ADMIN_PLATEFORM_URL=$PLATEFORM_URL
# Compile le serveur (TS → dist) et construit l'admin (build). Les secrets ne sont pas nécessaires au build.
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine
RUN apk add --no-cache vips-dev
WORKDIR /opt/app
# Strapi crée `database/migrations` au démarrage : le répertoire racine doit appartenir à l'utilisateur non-root.
RUN chown node:node /opt/app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /opt/app ./
USER node
# Scaleway Serverless Containers expose le port 8080.
ENV HOST=0.0.0.0 PORT=8080
EXPOSE 8080
CMD ["npm", "run", "start"]
