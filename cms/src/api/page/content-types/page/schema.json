{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Page composée de blocs (landing, page éditoriale…), rendue par plateform à la racine du site (/:slug, « / » autorisé : dispositif/service-civique)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 80,
      "regex": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "seoTitle": {
      "type": "string",
      "required": true
    },
    "seoDescription": {
      "type": "text"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "collection": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::collection.collection",
      "inversedBy": "pages"
    },
    "ctaLabel": {
      "type": "string",
      "maxLength": 40,
      "description": "Libellé des boutons « quiz » de la page (ex. : Trouvez votre mission). Vide : libellés par défaut (tutoiement)."
    },
    "blocks": {
      "type": "dynamiczone",
      "required": true,
      "components": [
        "blocks.hero",
        "blocks.mission-detail",
        "blocks.rich-text",
        "blocks.image",
        "blocks.missions",
        "blocks.etapes",
        "blocks.benefits",
        "blocks.cards",
        "blocks.stories",
        "blocks.testimonials",
        "blocks.faq",
        "blocks.accordion",
        "blocks.partners",
        "blocks.newsletter",
        "blocks.missions-browser",
        "blocks.quote-wall"
      ]
    }
  }
}
