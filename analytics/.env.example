# Variables des jobs analytics. Copier en .env : cp .env.example .env
#
# Origine en staging / production (terraform/jobs-analytics.tf) :
#   [tfvars]  valeur calculée par Terraform
#   [scw]     secret Scaleway "<workspace>-secret"
#   [gh]      variable GitHub du repo (vars.*)

ENV=development                                   # [tfvars]
DATABASE_URL_CORE=postgres://user:password@localhost:5433/api-engagement-core            # [scw]
DATABASE_URL_ANALYTICS=postgres://user:password@localhost:5431/api-engagement-analytics  # [scw]
# BATCH_SIZE=

# Tracking (PostHog)
# TRACKING_PROVIDER=
# POSTHOG_HOST=                                   # [scw]
# POSTHOG_PROJECT_ID=                             # [scw]
# POSTHOG_API_KEY=                                # [scw]
# POSTHOG_LOOKBACK_MINUTES=
# POSTHOG_SYNC_SINCE=

# Metabase / Slack / Sentry
# METABASE_URL=                                   # [scw]
# METABASE_API_KEY=                               # [scw]
# METABASE_DATABASE_NAME=                         # [scw]
# SLACK_TOKEN=                                    # [scw]
# SLACK_CRON_CHANNEL_ID=                          # [scw]
# SENTRY_DSN_JOBS=                                # [gh] vars.SENTRY_DSN_JOBS
