# Variables de la plateforme (app/services/config.ts). Copier en .env : cp .env.example .env
#
# Origine en staging / production :
#   [gh]      variable GitHub (vars.*), figée dans le bundle au build (docker-build-push.yml)
#   [tfvars]  terraform/containers.tf, lue au démarrage du conteneur (serveur)
#   [scw]     secret Scaleway "<workspace>-secret"

VITE_ENV=development                              # [gh] environnement du build
VITE_API_URL=http://localhost:4000                # [gh] vars.API_URL
VITE_PUBLISHER_ID=                                # [gh] vars.PLATEFORM_PUBLISHER_ID
# VITE_MAPTILER_API_KEY=                          # [gh] vars.VITE_MAPTILER_API_KEY (cartes)
# VITE_SENTRY_DSN=                                # [gh] vars.SENTRY_DSN_PLATEFORM (Sentry désactivé en development)
# VITE_TRACKING_PROVIDER=local                    # [gh] vars.TRACKING_PROVIDER
# VITE_POSTHOG_KEY=                               # [gh] vars.POSTHOG_KEY
# VITE_POSTHOG_HOST=https://eu.i.posthog.com      # [gh] vars.POSTHOG_HOST

# Côté serveur (rendu SSR)
PUBLISHER_API_KEY=                                # [scw] PLATEFORM_PUBLISHER_API_KEY
# SERVER_API_URL=                                 # [tfvars] défaut : VITE_API_URL

# Envoi des sourcemaps à Sentry au build (inutile en local)
# SENTRY_HOST=                                    # [gh] vars.SENTRY_HOST
# SENTRY_AUTH_TOKEN=                              # [gh] secret SENTRY_AUTH_TOKEN
