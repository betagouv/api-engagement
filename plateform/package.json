{
  "name": "plateform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3005",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write . --plugin=prettier-plugin-organize-imports",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test --grep @a11y"
  },
  "prettier": {
    "printWidth": 180
  },
  "dependencies": {
    "@engagement/dto": "file:../packages/dto",
    "@engagement/taxonomy": "file:../packages/taxonomy",
    "@gouvfr/dsfr": "1.15.3",
    "@gouvfr/dsfr-chart": "2.1.1",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@sentry/node": "10.72.0",
    "@sentry/react": "10.72.0",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "isbot": "5.2.2",
    "leaflet": "1.9.4",
    "posthog-js": "1.434.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0",
    "sanitize-html": "2.18.1",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  }
}
