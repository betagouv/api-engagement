{
  "name": "plateform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3005",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier": "prettier --write . --plugin=prettier-plugin-organize-imports",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prettier": {
    "printWidth": 180
  },
  "dependencies": {
    "@engagement/dto": "file:../packages/dto",
    "@engagement/taxonomy": "file:../packages/taxonomy",
    "@gouvfr/dsfr": "1.14.4",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "@sentry/react": "10.69.0",
    "@tailwindcss/vite": "4.3.3",
    "isbot": "5.2.1",
    "leaflet": "1.9.4",
    "posthog-js": "1.408.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "react-router": "8.3.0",
    "sanitize-html": "2.17.6",
    "tailwindcss": "4.3.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
