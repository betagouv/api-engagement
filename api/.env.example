# Variables de l'API, du worker et des jobs (src/config.ts). Copier en .env : cp .env.example .env
#
# Origine en staging / production :
#   [tfvars]  terraform/envs/<env>.tfvars ou valeur calculée par Terraform (terraform/containers.tf, jobs.tf)
#   [scw]     secret Scaleway "<workspace>-secret" — obligatoire si listé dans terraform/checks.tf
#   [gh]      variable GitHub du repo (vars.*)
# Les lignes commentées sont optionnelles en local (valeur par défaut du code ou fonctionnalité désactivée).

# --- Général ---
ENV=development                                   # [tfvars]
PORT=4000
PORT_WORKER=4001
# WORKSPACE=                                      # [tfvars] défaut : ENV
# IMAGE_VERSION=                                  # [tfvars] tag de l'image déployée
SECRET=not-so-secret                              # [scw] obligatoire hors development

# --- Base de données ---
DATABASE_URL_CORE=postgres://user:password@localhost:5433/api-engagement-core  # [scw]
# DATABASE_URL_CORE_REPLICA=                      # réplica en lecture, défaut : DATABASE_URL_CORE
# PRISMA_POOL_SIZE_CORE=                          # [tfvars]
# PRISMA_POOL_TIMEOUT=                            # [tfvars]
# PRISMA_CONNECT_TIMEOUT=                         # [tfvars]
# PRISMA_DEBUG_SQL=false

# --- URLs ---
API_URL=http://localhost:4000                     # [tfvars] api_hostname
APP_URL=http://localhost:3000                     # [tfvars] app_hostname
# PLATEFORM_URL=http://localhost:3005             # [tfvars] plateform_hostname
# BENEVOLAT_URL=http://localhost:3001             # [tfvars] benevolat_hostname
# VOLONTARIAT_URL=http://localhost:3001           # [tfvars] volontariat_hostname
# ASSOCIATION_URL=http://localhost:4001
# WORKER_URL=http://localhost:4001                # en development, les tâches async sont envoyées en HTTP au worker

# --- Sentry (désactivé en development) ---
# SENTRY_DSN_API=                                 # [gh] vars.SENTRY_DSN_API
# SENTRY_DSN_JOBS=                                # [gh] vars.SENTRY_DSN_JOBS
# SENTRY_DEBUG=false

# --- Emails / Slack ---
# SENDINBLUE_APIKEY=                              # [scw]
# BREVO_WEBHOOK_TOKEN=                            # [scw]
# SLACK_TOKEN=                                    # [scw]
# SLACK_CRON_CHANNEL_ID=                          # [scw]
# SLACK_WARNING_CHANNEL_ID=
# SLACK_LBC_CHANNEL_ID=
# SLACK_JOBTEASER_CHANNEL_ID=                     # [tfvars]

# --- Stockage S3 et files de messages Scaleway ---
# SCW_ACCESS_KEY=                                 # [scw]
# SCW_SECRET_KEY=                                 # [scw]
# SCW_HOST=https://s3.fr-par.scw.cloud
# REGION=fr-par
# BUCKET_NAME=api-engagement-bucket-staging       # [tfvars]
# SCW_QUEUE_ENDPOINT=                             # [tfvars] calculé par Terraform
# SCW_QUEUE_ACCESS_KEY=                           # [tfvars] calculé par Terraform, défaut : SCW_ACCESS_KEY
# SCW_QUEUE_SECRET_KEY=                           # [tfvars] calculé par Terraform, défaut : SCW_SECRET_KEY
# SCW_QUEUE_URL_MISSION_ENRICHMENT=               # [tfvars] calculé par Terraform
# SCW_QUEUE_URL_MISSION_SCORING=                  # [tfvars] calculé par Terraform
# SCW_QUEUE_URL_MISSION_INDEX=                    # [tfvars] calculé par Terraform
# SCW_QUEUE_URL_MISSION_DIFFUSION=                # [tfvars] calculé par Terraform
# SCW_QUEUE_URL_PUBLISHER_DIFFUSION=              # [tfvars] calculé par Terraform

# --- Typesense ---
TYPESENSE_HOST=localhost                          # [tfvars]
TYPESENSE_PORT=8108                               # [tfvars]
TYPESENSE_API_KEY=xyz                             # [scw]
# TYPESENSE_MISSION_COLLECTION=missions

# --- Enrichissement des missions (LLM) et matching ---
# MISTRAL_API_KEY=                                # [scw] lu directement par le SDK Mistral
# ALBERT_API_KEY=                                 # [scw]
# ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr
# MISSION_ENRICHMENT_PROVIDER=llm
# MISSION_ENRICHMENT_PROMPT_VERSION=v3            # [tfvars]
# MATCHING_ENGINE_VERSION=m3                      # [tfvars]

# --- Services tiers ---
# METABASE_URL=                                   # [scw]
# METABASE_API_KEY=                               # [scw]
# DEMARCHES_SIMPLIFIEES_TOKEN=                    # [scw]
# DEMARCHES_SIMPLIFIEES_BASE_URL=
# DATA_SUBVENTION_TOKEN=                          # [scw] jobs uniquement
# PILOTY_BASE_URL=https://sandbox-api.piloty.fr   # [tfvars] piloty_hostname
# LETUDIANT_PILOTY_TOKEN=                         # [scw]
# COCKPIT_METRICS_OTLP_URL=                       # [scw]
# COCKPIT_METRICS_TOKEN=                          # [scw]

# --- Sécurité ---
# MFA_ENABLED=true                                # [tfvars] enable_mfa
# RATE_LIMIT_DISABLED=false
# RATE_LIMIT_IP_MAX=120
# RATE_LIMIT_PUBLISHER_MAX=600

# --- Job de sauvegarde RDB ---
# RDB_BACKUP_INSTANCE_ID=                         # [tfvars] core_database_id
# RDB_BACKUP_DATABASE_NAME=                       # [tfvars]
# RDB_BACKUP_RETENTION_DAYS=7                     # [tfvars]

# --- Script ponctuel scripts/generate-rome-macro-competences.ts (API France Travail) ---
# FT_CLIENT_ID=
# FT_CLIENT_SECRET=
# FT_TOKEN_URL=
# FT_ROME_BASE_URL=
# FT_ROME_SCOPE=
# FT_ROME_MACRO_PATH=
