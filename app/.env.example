# Variables du back-office (src/services/config.js). Copier en .env : cp .env.example .env
# Les VITE_* sont figées dans le bundle au build : en staging / production elles sont passées
# en build args par .github/workflows/docker-build-push.yml.
#
# Origine en staging / production :
#   [gh]  variable GitHub (vars.*, repo ou environnement) — vérifiée par l'étape "Check required build values"

VITE_ENV=development                              # [gh] environnement du build
VITE_API_URL=http://localhost:4000                # [gh] vars.API_URL
# VITE_BENEVOLAT_URL=                             # [gh] vars.BENEVOLAT_URL
# VITE_VOLONTARIAT_URL=                           # [gh] vars.VOLONTARIAT_URL
# VITE_SENTRY_DSN=                                # [gh] vars.SENTRY_DSN_APP (Sentry désactivé en development)

# Envoi des sourcemaps à Sentry au build (inutile en local)
# SENTRY_HOST=                                    # [gh] vars.SENTRY_HOST
# SENTRY_AUTH_TOKEN=                              # [gh] secret SENTRY_AUTH_TOKEN
